# ─────────────────────────────────────────────────────────────────────────────────────
# The one-command Moxie stack — copy this file to `.env` and edit. It is the SINGLE
# config file for `docker compose up` (guide: docs/guides/one-command-stack.md).
#
#     cp .env.example .env
#
# Every value here has a working default, so the stack starts with no .env at all.
# `.env` is git-ignored: NEVER put a real API key in this .example file.
#
# NOTE: docker compose does NOT strip trailing comments from an env file — `KEY=v # why`
# makes the value "v # why". Every comment below therefore sits on its own line.
# (Running the supervisor bare-metal instead? That reads mqtt/.env — same knob names.)
# ─────────────────────────────────────────────────────────────────────────────────────

# ── the network the robot sees ───────────────────────────────────────────────────────
# The host/IP a REAL ROBOT uses to reach your broker. It goes into the endpoint QR and
# into the broker cert's subjectAltName, so set it to this machine's LAN IP BEFORE the
# first `up` (afterwards: `docker compose down -v` to regenerate the certs).
MOXIE_BROKER_HOST=127.0.0.1

# Which host interface the published ports bind to. 0.0.0.0 = reachable from the LAN
# (what a robot or a phone needs); 127.0.0.1 = this machine only.
MOXIE_BIND_HOST=0.0.0.0

# ── host ports (change these if something already uses them) ─────────────────────────
# broker, TLS — the robot
MOXIE_PORT_MQTT_TLS=8883
# broker, plain — the SIM, sim/virtual_moxie.py, the tests
MOXIE_PORT_MQTT=1883
# broker, MQTT-over-WebSocket — the browser UI
MOXIE_PORT_WS=9001
# the parent console + mobile web app
MOXIE_PORT_CONSOLE=8080
# the supervisor's /status, /telemetry, /config (an unauthenticated admin surface —
# it stays on 127.0.0.1 unless you widen MOXIE_BIND_HOST)
MOXIE_PORT_STATUS=8931

# ── which brain drives Moxie ─────────────────────────────────────────────────────────
# content = the data-driven content module (default) · llm = free-form companion
# echo    = repeat back, no LLM needed (handy for testing the plumbing)
# webhook = hand every turn to an external service (set MOXIE_WEBHOOK_ENDPOINT)
MOXIE_APP=content
MOXIE_CONTENT_MODULE=content_modules/starter.json
MOXIE_CHILD_NICKNAME=friend
MOXIE_WEBHOOK_ENDPOINT=

# ── the LLM gateway (any OpenAI-compatible endpoint: LiteLLM, Ollama, vLLM, LM Studio) ─
# `content` and `llm` need this to answer. Without a key the supervisor still runs and
# the robot still connects — Moxie just falls back to "my brain got fuzzy".
MOXIE_LLM_BASE_URL=https://gateway.graphlings.net/v1
# <-- your key goes here. Never commit it.
MOXIE_LLM_API_KEY=
MOXIE_LLM_MODEL=graphling-medium

# Seconds the brain may think before Moxie speaks a short "let me think" line and
# delivers the real answer as a second chunk. The robot re-prompts after ~20 s of
# silence, so this is what keeps a slow model from leaving a child with nothing.
# 0 turns it off.
MOXIE_BRAIN_BUDGET_S=6

# Which robots this appliance will serve. The broker accepts anonymous connections, so
# by default (left empty) a robot that connects is *pending*: it gets a minimal config
# with NO child data and nothing else, until you permit it in the console's 🔐 Robot
# access card. Set to 1 to serve any robot that connects — the behavior before the
# allowlist existed, and a real exposure on a shared network.
MOXIE_ALLOW_UNVERIFIED_BOTS=

# Stream the answer: each finished sentence is spoken as soon as the model writes it,
# so the child hears the first line in a few seconds instead of waiting for the whole
# reply. A stalled stream re-arms the "let me think" line above (at most twice a turn).
# 0 = wait for the complete answer and send it as one reply.
MOXIE_STREAMING=1

# Perform the line instead of reading it out: the server turns each reply into Moxie's
# real behavior markup — a face, an arm gesture on the words that matter, a pause between
# sentences — from the vocabularies recovered in docs/reverse-engineering/. Costs nothing
# (local string work, no extra model call). 0 = plain text, the way it used to be.
MOXIE_AUTOMARKUP=1

# ── the voice ────────────────────────────────────────────────────────────────────────
# tone = the built-in zero-dependency placeholder voice (no model, no key, works now)
# ''   = auto: a voice server if set, else Piper if a model is set, else silent
# off  = no server-side voice (a real robot synthesizes on-device anyway)
MOXIE_TTS=tone

# Offline Piper voice — `docker compose --profile voice up voice-model` downloads the
# model; BOTH lines below are then needed, plus `docker compose up -d --build`.
# EXTRAS example: piper-tts   (or: faster-whisper numpy   for the ears below)
MOXIE_SUPERVISOR_EXTRAS=
# Example: /models/en_US-amy-medium.onnx  — an empty value keeps Piper off.
MOXIE_PIPER_MODEL=
# Optional; defaults to <model>.json next to the .onnx
MOXIE_PIPER_CONFIG=
MOXIE_PIPER_VOICE_URL=https://huggingface.co/rhasspy/piper-voices/resolve/main/en/en_US/amy/medium/en_US-amy-medium.onnx

# A remote OpenAI-compatible voice server instead (/audio/speech). Wins over Piper —
# and falls back to it (or to the tone) if the server hiccups, so a turn is never silent.
# Our LiteLLM gateway serves this since 2026-09-02: docs/guides/litellm-tts-setup.md
# Set to https://gateway.graphlings.net/v1 to speak through it.
MOXIE_VOICE_BASE_URL=
# Falls back to MOXIE_LLM_API_KEY when empty.
MOXIE_VOICE_API_KEY=
# The TTS model = the voice on our gateway: piper-amy (Moxie's own) or piper-ryan.
MOXIE_VOICE_MODEL=piper-amy
# wav (default) carries its own sample rate in the header; pcm is raw 16-bit frames.
MOXIE_VOICE_FORMAT=wav
# pcm ONLY (a wav reply overrides it from the header). The gateway's Piper voices: 22050.
MOXIE_VOICE_SAMPLE_RATE=22050
# The `voice` request field. Empty = derived from the model name (piper-amy -> amy),
# which is what our gateway wants: it REQUIRES the field and IGNORES its value.
MOXIE_TTS_VOICE=

# ── the ears (speech-to-text) ────────────────────────────────────────────────────────
# auto = on when faster-whisper is installed in the supervisor image (see
# MOXIE_SUPERVISOR_EXTRAS above and `docker compose --profile stt up stt-model`).
# off  = never.
MOXIE_STT=auto
MOXIE_STT_MODEL=base.en

# ── prebuilt images (docker-compose.images.yml only) ─────────────────────────────────
# The no-clone path pulls our published multi-arch images from GHCR. These three knobs
# are ignored by the build-from-clone docker-compose.yml.
# Where the images live. Point it at a mirror or a local registry if you have one.
MOXIE_IMAGE_REGISTRY=ghcr.io/mvalancy/moxie-robot-saver
# latest = the newest stable release. Pin a version (e.g. 0.6.2, or 0.6) for a fleet you
# do not want moving under you; `docker compose -f docker-compose.images.yml pull` updates.
MOXIE_IMAGE_TAG=latest
# missing = pull only when the image is not already local (the default). `always` re-checks
# the registry on every `up`; `never` forbids a pull (what the compose smoke uses).
MOXIE_IMAGE_PULL_POLICY=missing
