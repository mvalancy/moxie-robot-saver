# Env file for sim/run_compose_smoke.sh — the composed-stack proof.
#
# Two deliberate differences from a real deployment:
#  * every published port is moved off the defaults, so the smoke can never collide with
#    (or kill) a stack you already have running on 1883/8080/8930;
#  * the brain is `echo`, which needs no LLM key or network. The default stack's brain is
#    `content`, which answers through the gateway — that path is covered by the live
#    tests (sim/tests/test_live_gateway.py), not by this hermetic smoke.
# Everything else — broker, TLS certs, supervisor, voice, console — is exactly what
# `docker compose up` gives you.

MOXIE_BIND_HOST=127.0.0.1
MOXIE_PORT_MQTT=1921
MOXIE_PORT_MQTT_TLS=8993
MOXIE_PORT_WS=9921
MOXIE_PORT_CONSOLE=8921
MOXIE_PORT_STATUS=8991

MOXIE_APP=echo
MOXIE_TTS=tone
MOXIE_STT=off
MOXIE_CHILD_NICKNAME=friend
MOXIE_BROKER_HOST=127.0.0.1
MOXIE_LLM_API_KEY=
MOXIE_SUPERVISOR_EXTRAS=
