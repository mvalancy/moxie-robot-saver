# NEVER commit the proprietary app or any extracted Embodied binaries
*.xapk
*.apk
*.dex
*.so
*.jar
work/
jadx-out/
apktool-out/
tools/jadx/
tools/apktool*

# Python
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
*.egg-info/

# Node
node_modules/
dist/

# Secrets / local
*.key
*.pem
.env
secrets/

# server runtime
server/moxie.db*

# MQTT broker private keys (each appliance generates its own via gen-certs.sh)
mqtt/broker/keys/
mqtt/broker/log/

# large / proprietary firmware images (never commit)
# NOTE: anchored to the repo root — an unanchored `firmware/` also matched
# docs/reverse-engineering/firmware/ and the docs-bundle mirror, silently
# dropping tracked docs (broke CI: missing firmware/README.md + stale bundle).
/firmware/
*.img

# qr-rig runtime
tools/qr-rig/qr_rig.log
tools/qr-rig/__pycache__/
sim/.env
sim/tts/voices/*.onnx
mqtt/.env

# supervisor durable store (per-robot JSON: mentor behaviors, …) — runtime state,
# not source. Override the location with MOXIE_DATA_DIR. The README stays tracked so
# the folder is still navigable.
mqtt/data/*
!mqtt/data/README.md
