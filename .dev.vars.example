# .dev.vars.example — the hosted Sim demo's configuration, as a local template.
#
# Copy to `.dev.vars` for `npx wrangler pages dev sim/web`. **NEVER COMMIT `.dev.vars`.**
# `.gitignore` already ignored `.env`; this slice adds `.dev.vars` next to it.
#
# In PRODUCTION these are NOT set from a file. They are Cloudflare environment
# variables on the Pages project — dashboard -> Workers & Pages -> the project ->
# Settings -> Environment variables, **Production environment only**, with the two
# secrets stored as encrypted variables (or `npx wrangler pages secret put <NAME>`).
# They are never put in `wrangler.toml`: that file is committed and world-readable.
#
# Set them on Production only and previews are automatically safe: a branch preview
# with no variables answers `gateway_not_configured` on every route, makes no upstream
# call at all, and is exactly the scripted static demo.
#
# The full table, with every default and the reasoning behind every number, is
# docs/architecture/backlog/live-sim-demo.md §5. Only the values below have no default.

# The kill switch. `0` forces every route to `gateway_not_configured` WITHOUT deleting
# the secret — the fastest incident response there is.
DEMO_ENABLED=1

# Any OpenAI-compatible base. NO DEFAULT EXISTS, on purpose: unset means degraded,
# never "guess ours". Nothing in this repo knows a gateway hostname.
DEMO_GATEWAY_BASE_URL=https://your-gateway.example/v1

# The key. Read only as `context.env.DEMO_GATEWAY_API_KEY`, inside a Pages Function,
# and never echoed, logged or sent to the browser in any form.
#
# USE A SEPARATE, BUDGET-SCOPED KEY FOR THE PUBLIC DEMO — never the key your local
# stack and your live tests use. If your gateway can mint a virtual key with a hard
# budget and RPM/TPM limits, that is the single strongest control available here and
# everything the Functions enforce becomes defence in depth (spec §4.2).
DEMO_GATEWAY_API_KEY=replace-me-with-a-budget-scoped-key

# The chat model. No default: a wrong id costs a failed PAID request.
DEMO_CHAT_MODEL=your-chat-model

# The voice. Unset => `voice: false`, and text still works — spoken from the shipped
# clips or the browser voice, which is what the site does today.
DEMO_TTS_MODEL=your-tts-model

# The ears. Unset => `/api/health` reports `ears: false`, `/api/transcribe` answers
# `gateway_not_configured` and makes NO upstream call, and `mic.js` keeps the scripted
# child line it has always fallen back to. Set it and a visitor can speak to Moxie.
DEMO_STT_MODEL=your-stt-model

# Which containers this gateway accepts at /v1/audio/transcriptions. THE DEFAULT OF `wav`
# ALONE IS A MEASUREMENT, NOT CAUTION: probed live on 2026-09-03, our gateway's
# `stt-whisper` transcribed a 16 kHz mono RIFF/WAVE word-perfect in 2.58 s and answered
# HTTP 500 to webm/Opus, ogg/Opus and mp4/AAC alike. Because 500 means `upstream_down`,
# which degrades the WHOLE page, forwarding a browser's default recording would take the
# brain and the voice down every time someone pressed the microphone — so anything outside
# this list is refused per-turn, for free, and `sim/web/mic.js` encodes 16 kHz WAV in the
# browser instead. If YOUR gateway is more capable (OpenAI's own Whisper API documents
# webm), widen it: DEMO_STT_FORMATS=wav,webm,ogg,mp4,mp3,flac
# DEMO_STT_FORMATS=wav

# How long the browser is allowed to record, in ms. THIS IS THE ONLY HONEST CEILING ON
# WHAT THE EARS CAN COST, and it is why it is here rather than being left to a default:
# `DEMO_MAX_AUDIO_BYTES` (500 000) is ~15 s of 16 kHz PCM but MINUTES of the webm/Opus a
# browser's MediaRecorder actually produces, and a Pages Function only ever sees the
# finished upload. The value is published in `/api/health`'s `limits` and `sim/web/mic.js`
# stops the recorder on it. Lower it to make a public demo cheaper; the page obeys
# immediately, with no redeploy of anything but the variable.
# DEMO_MAX_RECORD_MS=15000

# ---------------------------------------------------------------------------
# A gateway behind a CLOUDFLARE TUNNEL
# ---------------------------------------------------------------------------
# A plain public tunnel hostname needs nothing extra: put it in
# DEMO_GATEWAY_BASE_URL above and everything works unchanged.
#
# The two variables below are needed ONLY when the tunnel is protected by
# CLOUDFLARE ACCESS. An Access-protected hostname answers an unauthenticated
# server-side fetch with an HTML LOGIN PAGE AT STATUS 200 — which looks exactly
# like a broken gateway and is maddening to diagnose. So configure a SERVICE
# TOKEN (Cloudflare dashboard -> Zero Trust -> Access -> Service Auth) and the
# Functions will present it as CF-Access-Client-Id / CF-Access-Client-Secret on
# every upstream call, alongside the gateway key rather than instead of it.
#
# BOTH OR NEITHER. Exactly one of the pair is treated as a MISCONFIGURATION:
# every route answers `gateway_not_configured` and makes no upstream call,
# because calling half-credentialled would produce that same login page while
# looking configured.
#
# The _SECRET half is a SECRET binding in production (an encrypted variable, or
# `npx wrangler pages secret put DEMO_GATEWAY_ACCESS_CLIENT_SECRET`), exactly
# like DEMO_GATEWAY_API_KEY. The _ID half is a var but is still a credential.
#
# If it is ever misconfigured anyway, the routes answer the envelope with
# `reason: "gateway_unreachable_or_gated"` rather than a bare 502 — the page
# degrades with the same copy a dead gateway gets, and the reason says which of
# the two it actually is.
#
# DEMO_GATEWAY_ACCESS_CLIENT_ID=0123456789abcdef0123456789abcdef.access
# DEMO_GATEWAY_ACCESS_CLIENT_SECRET=replace-me-with-a-service-token-secret

# Optional. Signs the speech tickets and the conversation blobs. When unset it is an
# HKDF of DEMO_GATEWAY_API_KEY, so the minimum configuration stays two values. Set it
# explicitly if you rotate the gateway key often — rotation otherwise invalidates
# in-flight 60-second tickets, which is harmless.
# DEMO_TICKET_SECRET=

# Everything else has a default: DEMO_MAX_TOKENS=160, DEMO_MAX_INPUT_CHARS=500,
# DEMO_MAX_TTS_CHARS=300, DEMO_CHAT_PER_MIN=5, DEMO_MAX_CONCURRENT_CHAT=4,
# DEMO_UNIT_BUDGET_HOUR=600, DEMO_CHAT_TIMEOUT_MS=20000, DEMO_TICKET_TTL_S=60,
# DEMO_MAX_AUDIO_BYTES=500000, DEMO_MIN_AUDIO_BYTES=2000, DEMO_STT_PER_MIN=10,
# DEMO_STT_PER_HOUR=60, DEMO_STT_TIMEOUT_MS=12000,
# DEMO_QUEUE_MAX_WAIT_MS=2500, DEMO_QUEUE_MAX_DEPTH=8 (the bounded wait behind the
#   concurrency ceiling — set either to 0 to refuse instantly instead of queueing), …
# See the spec's §5 for the whole table and why each number is what it is.
