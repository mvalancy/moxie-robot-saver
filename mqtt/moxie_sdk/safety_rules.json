        "\\bbeat\\s+(?:him|her|them|me)\\s+up\\b"
      ],
      "allow": [
        "\\bshoot(?:ing)?\\s+(?:a|some|the|my|another)?\\s?(?:photo|picture|pic|video|hoops|basket|star|arrow|for the (?:stars|moon))",
        "\\bshoot\\s+(?:me\\s+)?(?:a\\s+)?(?:message|text|email)\\b",
        "\\bkill(?:ing)?\\s+(?:the\\s+)?(?:lights|time|engine|music|mood)\\b",
        "\\bkill(?:ing)?\\s+myself\\s+laughing\\b",
        "\\bkilling\\s+it\\b",
        "\\bkilled\\s+it\\b",
        "\\bmy\\s+(?:feet|legs|head|back|arm|tooth|stomach)\\s+(?:is|are)\\s+killing\\s+me\\b",
        "\\bkill(?:ed|ing)?\\s+(?:a\\s+|the\\s+|some\\s+)?(?:boss|zombie|creeper|monster|dragon|goblin|slime|mob)s?\\b",
