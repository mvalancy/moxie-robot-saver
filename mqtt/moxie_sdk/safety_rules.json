{
  "_readme": [
    "Moxie's safety rules — the whole table, in one file a parent can read.",
    "",
    "This file IS the v1 classifier: moxie_sdk/safety.py only compiles and applies it.",
    "Nothing is hidden in code, nothing is sent to a cloud service, and you can edit this",
    "file (or point MOXIE_SAFETY_RULES at your own copy) to change what Moxie checks.",
    "",
    "WARNING: to filter offensive words a filter has to list them. The `words` arrays",
    "below contain slurs and profanity on purpose. That is the only reason they are here.",
    "",
    "Each category has:",
    "  id          - the string that appears in InputSafety.blocked_by on the wire",
    "  label       - what the parent console calls it",
    "  action      - what happens, per side: 'block' (never spoken, redirect instead),",
    "                'flag' (allowed through, recorded for a parent to review), 'allow'",
    "                'child' = something the child said; 'moxie' = something Moxie is about to say",
    "  escalate    - true for the categories a parent should look at first",
    "  intents     - InputSafety.intents on the wire",
    "  phrase_set  - which redirect line Moxie speaks when this category blocks",
    "  words       - matched whole-word only (\\b...\\b), case/accent/leet-insensitive",
    "  phrases     - regular expressions, matched on the same normalized text",
    "  allow       - false-positive guards: these spans are REMOVED before this category",
    "                is matched, so 'shoot a photo' never counts as violence",
    "",
    "Order matters: the first blocking category in this list picks the spoken redirect."
  ],
  "version": 1,
  "categories": [
    {
      "id": "self_harm",
      "label": "Self-harm",
      "action": { "child": "block", "moxie": "block" },
      "escalate": true,
      "intents": ["self_harm_disclosure"],
      "phrase_set": "self_harm",
      "words": ["suicide", "suicidal", "selfharm"],
      "phrases": [
        "\\b(?:kill|hurt|harm|cut|starve|burn)(?:ing)?\\s+(?:my ?self|myself|him ?self|her ?self|them ?selves)\\b",
        "\\bi\\s+(?:want|wanna|need|am going|'m going|plan)\\s+to\\s+(?:die|disappear|end it|not (?:be|exist))\\b",
        "\\bi\\s+(?:wish|hope)\\s+i\\s+(?:was|were)\\s+dead\\b",
        "\\b(?:end|take)\\s+(?:my|his|her|their)\\s+(?:own\\s+)?life\\b",
        "\\bnobody\\s+would\\s+(?:miss|care about)\\s+me\\b",
        "\\bhow\\s+(?:do i|to|can i)\\s+(?:kill|hurt|cut)\\s+(?:my ?self|myself)\\b"
      ],
      "allow": [
        "\\bkill(?:ing)?\\s+myself\\s+laughing\\b",
        "\\bdying\\s+(?:of|to)\\b"
      ]
    },
    {
      "id": "violence",
      "label": "Violence & weapons",
      "action": { "child": "block", "moxie": "block" },
      "escalate": true,
      "intents": ["violence_instructions", "threat"],
      "phrase_set": "generic",
      "words": ["behead", "molotov", "napalm", "thermite", "pipebomb"],
      "phrases": [
        "\\bhow\\s+(?:do (?:i|you)|to|can (?:i|you))\\s+\\w{0,12}\\s?(?:make|build|get|buy|use|fire|load|shoot)\\s+(?:a|an|the|my)?\\s?(?:bomb|gun|rifle|pistol|shotgun|weapon|explosive|grenade|poison|knife)\\b",
        "\\bhow\\s+(?:do (?:i|you)|to|can (?:i|you))\\s+(?:kill|murder|stab|shoot|strangle|poison|hurt|beat up)\\s+(?:a |an |the |my |some ?)?(?:one|body|person|people|kid|girl|boy|man|woman|teacher|mom|dad|brother|sister)\\b",
        "\\b(?:i(?:'m| am)? (?:going to|gonna|want to|wanna)|let'?s)\\s+(?:kill|shoot|stab|strangle|murder|blow up)\\s+(?:you|him|her|them|everyone|my|the)\\b",
        "\\b(?:bring|take|sneak)\\s+(?:a|my|the)\\s+(?:gun|knife|weapon|bomb)\\s+to\\s+(?:school|class)\\b",
        "\\bschool\\s+shoot(?:ing|er)\\b",
        "\\bhow\\s+(?:do i|to)\\s+(?:mix|make)\\s+(?:bleach|chlorine)\\s+(?:and|with)\\s+ammonia\\b"
      ],
      "allow": []
    },
    {
      "id": "sexual",
      "label": "Sexual content",
      "action": { "child": "block", "moxie": "block" },
      "escalate": true,
      "intents": ["sexual_content"],
      "phrase_set": "generic",
      "words": [
        "porn", "pornhub", "blowjob", "handjob", "cum", "creampie", "orgasm",
        "masturbate", "masturbating", "jerkoff", "boner", "dildo", "vibrator",
        "titties", "boobs", "nudes", "sexting", "horny", "erection", "genitals",
        "penis", "vagina"
      ],
      "phrases": [
        "\\bsend\\s+(?:me\\s+)?(?:a\\s+)?(?:nude|naked|sexy)\\b",
        "\\b(?:take|show)\\s+(?:off\\s+)?(?:your|my)\\s+clothes\\b",
        "\\bhave\\s+sex\\b",
        "\\bsex(?:ual)?\\s+(?:with|position|video|story|stuff)\\b",
        "\\bmake\\s+out\\s+with\\s+me\\b"
      ],
      "allow": [
        "\\bsex\\s+education\\b",
