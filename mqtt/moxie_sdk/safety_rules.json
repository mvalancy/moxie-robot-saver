    {
      "id": "dangerous",
      "label": "Dangerous activities",
      "action": { "child": "flag", "moxie": "block" },
      "escalate": false,
      "intents": ["dangerous_activity"],
      "phrase_set": "generic",
      "words": ["huffing", "vaping", "overdose"],
      "phrases": [
        "\\b(?:drink|swallow|eat|taste|sniff)\\s+(?:some\\s+)?(?:bleach|poison|detergent|gasoline|antifreeze|pills|medicine)\\b",
        "\\bplay(?:ing)?\\s+with\\s+(?:matches|a lighter|fire|knives|the stove)\\b",
        "\\b(?:climb|jump)(?:ing)?\\s+(?:on|off|from)\\s+(?:the\\s+)?(?:roof|balcony|window|bridge)\\b",
        "\\bstick\\s+(?:a|my|something)\\s+\\w{0,10}\\s?in(?:to)?\\s+(?:the\\s+)?(?:outlet|socket|plug)\\b",
        "\\b(?:how\\s+(?:do i|to)\\s+)?(?:get|buy|smoke|drink)\\s+(?:some\\s+)?(?:beer|vodka|alcohol|weed|marijuana|cigarettes|drugs)\\b",
        "\\bhold\\s+my\\s+breath\\s+until\\b",
        "\\bhome\\s+alone\\s+and\\s+the\\s+door\\s+is\\s+open\\b"
      ],
      "allow": [
        "\\bfire\\s+drill\\b",
        "\\bplay(?:ing)?\\s+with\\s+fire\\s+(?:in|from)\\s+(?:the\\s+)?(?:game|story|book|movie)\\b"
