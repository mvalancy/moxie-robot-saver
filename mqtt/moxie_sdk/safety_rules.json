    {
      "id": "violence_talk",
      "label": "Violent talk",
      "action": { "child": "flag", "moxie": "flag" },
      "escalate": false,
      "intents": ["violent_language"],
      "phrase_set": "generic",
      "words": ["kill", "kills", "killed", "killing", "gun", "guns", "shoot",
