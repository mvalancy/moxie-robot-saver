# Robot-cloud supervisor config. Copy to mqtt/.env (git-ignored) and fill in.
# NEVER commit real keys — .env is ignored; this .example is the only tracked copy.
#
# Two switches for THIS FILE cannot live in it, and are read from the environment only:
#   MOXIE_SKIP_DOTENV=1        ignore mqtt/.env entirely (what the tests set, so that
#                              "nothing is configured" really means nothing)
#   MOXIE_DOTENV=/path/to/file read that file instead of mqtt/.env

# --- which brain drives Moxie ---
MOXIE_APP=llm                 # llm | content | echo | webhook
MOXIE_CHILD_NICKNAME=friend

# --- LLM brain (REQUIRED for MOXIE_APP=llm and MOXIE_APP=content) ---
# There is NO default endpoint. This repo is public and any OpenAI-compatible server is
# supposed to work, so shipping one deployment as the fallback would point every fork at
# it — the supervisor exits at startup naming this variable instead. Examples:
#   http://127.0.0.1:11434/v1   Ollama on this machine
#   http://127.0.0.1:8000/v1    vLLM / LM Studio / your own LiteLLM
#   https://your-gateway.example/v1
# MOXIE_APP=echo needs none of this and is how you bring the supervisor up without a brain.
MOXIE_LLM_BASE_URL=
MOXIE_LLM_API_KEY=            # <-- your gateway key (required for live LLM)
MOXIE_LLM_MODEL=graphling-medium   # whatever the endpoint above calls its chat model

# --- brain latency (background inference + filler) ---
# Seconds the brain may think before Moxie says a short "let me think" line
# (result=REPLY_PENDING, chunk 0) and delivers the real answer as chunk 1. The robot
# re-prompts after ~20 s of silence and a live gateway turn was measured at 45 s, so
# this is what stops a slow brain from leaving a child with nothing. 0 disables it.
MOXIE_BRAIN_BUDGET_S=6

# --- device allowlist (the pairing gate) ---
# Our broker accepts anonymous connections, so "reached the port" must not mean "is my
# child's robot". By DEFAULT (this left empty/unset) a robot that connects is *pending*:
# it gets a minimal config with no child_pii and is served nothing else until a parent
# permits it in the console (durable in $MOXIE_DATA_DIR/fleet/permits.json).
# Set to 1 to serve any robot that connects — the pre-gate behavior, for a deployment
# that was already running. The console has the same switch, with the same warning.
MOXIE_ALLOW_UNVERIFIED_BOTS=

# --- streaming replies ---
# 1 = publish each finished sentence as its own chunk (result=REPLY_PENDING + chunk_num,
# closed by consistency_control.is_completed) as the model writes it — first words in
# ~3-5 s instead of 18-45 s. 0 = the old single-reply path.
MOXIE_STREAMING=1

# --- expressive markup (the markup floor) ---
# 1 = every reply that does not bring its own markup is performed: a mood for the line
# (ePlaybackMood 0-10), a <usel> delivery on a question or an exclamation, arm gestures on
# the words that carry the thought, a pause at an internal sentence boundary, and a
# closing Gesture_None. Pure local string work — no extra model call, no I/O.
# 0 = the old behavior: a passthrough at the seam, one mood + one gesture in the LLM app.
MOXIE_AUTOMARKUP=1

# --- content app (data-driven activities) ---
MOXIE_CONTENT_MODULE=content_modules/starter.json

# --- AI voice server (optional; STT/TTS for the SIM + a server voice) ---
# LIVE since 2026-09-02 on our LiteLLM gateway — same host, same key as chat. Setting
# the base URL is the whole switch; see docs/guides/litellm-tts-setup.md.
MOXIE_VOICE_BASE_URL=         # e.g. https://gateway.graphlings.net/v1 (empty -> Piper/tone)
MOXIE_VOICE_API_KEY=          # falls back to MOXIE_LLM_API_KEY if unset
MOXIE_VOICE_MODEL=piper-amy   # the model IS the voice: piper-amy (Moxie's) | piper-ryan
MOXIE_VOICE_FORMAT=wav        # wav (header carries the true rate) | pcm (raw 16-bit)
MOXIE_VOICE_SAMPLE_RATE=22050 # pcm ONLY; a wav reply overrides it from its own header
MOXIE_TTS_VOICE=              # the `voice` field; empty -> derived (piper-amy -> amy).
                              # Our gateway requires the field and ignores its value.
MOXIE_TTS=              # engine hint: ''=auto (voice/piper/none), 'tone'=built-in zero-dep voice, 'off'

# --- local Piper voice (offline; our default/primary — Amy) ---
# Used when no voice server is set + piper is installed (pip install 'moxie-cloud-sdk[tts]').
# Point at a downloaded Piper .onnx model; the SIM then speaks with no gateway/creds.
# This variable — not MOXIE_TTS — is what turns Piper on. In this repo the voices live
# (git-ignored, 63 MB each) in sim/tts/voices/: en_US-amy-medium.onnx is Moxie's voice.
MOXIE_PIPER_MODEL=            # e.g. /models/en_US-amy-medium.onnx  (empty → off)
MOXIE_PIPER_CONFIG=          # optional; defaults to <model>.json next to the .onnx

# --- STT: the ears (mic audio on events/zmq → text, AI seam §1) ---
# TWO first-class engines, one line apart — see docs/guides/litellm-stt-setup.md:
#   whisper  local faster-whisper (pip install 'moxie-cloud-sdk[stt]'). No network, no
#            key, nothing leaves the house — the home-appliance answer. Wins even when a
#            gateway URL is set, which is the point of naming it.
#   gateway  our LiteLLM gateway, LIVE since 2026-09-02 — same host and key as the brain
#            and the voice. The hosted answer (a container/VPS/Cloudflare-fronted SIM has
#            nowhere to put a 140 MB model), with local whisper latching in behind it if
#            it is installed.
#   auto     (default) the gateway when a URL *and* a key are present, else local whisper
#            when installed, else off — text turns keep working either way.
MOXIE_STT=auto                # auto | gateway | whisper (alias: local) | off
MOXIE_STT_MODEL=              # empty → the engine's own default: stt-whisper on the
                              # gateway (also graphling-stt, stt-whisper-base),
                              # base.en locally (tiny.en, small.en, …)
MOXIE_STT_BASE_URL=           # empty → MOXIE_VOICE_BASE_URL → MOXIE_LLM_BASE_URL
MOXIE_STT_API_KEY=            # empty → MOXIE_VOICE_API_KEY → MOXIE_LLM_API_KEY

# --- broker ---
MOXIE_BROKER_HOST=192.168.1.9  # host/IP the ROBOT uses to reach the broker (endpoint QR)
