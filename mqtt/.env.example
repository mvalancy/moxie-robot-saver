# Robot-cloud supervisor config. Copy to mqtt/.env (git-ignored) and fill in.
# NEVER commit real keys — .env is ignored; this .example is the only tracked copy.

# --- which brain drives Moxie ---
MOXIE_APP=llm                 # llm | content | echo | webhook
MOXIE_CHILD_NICKNAME=friend

# --- LLM brain (our LiteLLM gateway by default) ---
MOXIE_LLM_BASE_URL=https://gateway.graphlings.net/v1
MOXIE_LLM_API_KEY=            # <-- your gateway key (required for live LLM)
MOXIE_LLM_MODEL=graphling-medium   # gateway models: graphling-small/medium/large, qwen2.5-7b, deepseek-v4-flash …

# --- brain latency (background inference + filler) ---
# Seconds the brain may think before Moxie says a short "let me think" line
# (result=REPLY_PENDING, chunk 0) and delivers the real answer as chunk 1. The robot
# re-prompts after ~20 s of silence and a live gateway turn was measured at 45 s, so
# this is what stops a slow brain from leaving a child with nothing. 0 disables it.
MOXIE_BRAIN_BUDGET_S=6

# --- streaming replies ---
# 1 = publish each finished sentence as its own chunk (result=REPLY_PENDING + chunk_num,
# closed by consistency_control.is_completed) as the model writes it — first words in
# ~3-5 s instead of 18-45 s. 0 = the old single-reply path.
MOXIE_STREAMING=1

# --- expressive markup (the markup floor) ---
# 1 = every reply that does not bring its own markup is performed: a mood for the line
# (ePlaybackMood 0-10), a <usel> delivery on a question or an exclamation, arm gestures on
# the words that carry the thought, a pause at an internal sentence boundary, and a
# closing Gesture_None. Pure local string work — no extra model call, no I/O.
# 0 = the old behavior: a passthrough at the seam, one mood + one gesture in the LLM app.
MOXIE_AUTOMARKUP=1

# --- content app (data-driven activities) ---
MOXIE_CONTENT_MODULE=content_modules/starter.json

# --- AI voice server (optional; STT/TTS for the SIM + a server voice) ---
MOXIE_VOICE_BASE_URL=         # OpenAI-compatible audio endpoint, e.g. https://speech.graphlings.net/v1 (not up yet)
MOXIE_VOICE_API_KEY=          # falls back to MOXIE_LLM_API_KEY if unset
MOXIE_TTS_VOICE=alloy
MOXIE_TTS=              # engine hint: ''=auto (voice/piper/none), 'tone'=built-in zero-dep voice, 'off'

# --- local Piper voice (offline; our default/primary — Amy) ---
# Used when no voice server is set + piper is installed (pip install 'moxie-cloud-sdk[tts]').
# Point at a downloaded Piper .onnx model; the SIM then speaks with no gateway/creds.
# This variable — not MOXIE_TTS — is what turns Piper on. In this repo the voices live
# (git-ignored, 63 MB each) in sim/tts/voices/: en_US-amy-medium.onnx is Moxie's voice.
MOXIE_PIPER_MODEL=            # e.g. /models/en_US-amy-medium.onnx  (empty → off)
MOXIE_PIPER_CONFIG=          # optional; defaults to <model>.json next to the .onnx

# --- local STT (offline; faster-whisper) ---
# The other half of the voice seam: mic audio on events/zmq → text (AI seam §1).
# 'auto' uses faster-whisper when it is installed (pip install 'moxie-cloud-sdk[stt]')
# and is a clean no-op when it isn't — text turns keep working either way.
MOXIE_STT=auto                # auto | off
MOXIE_STT_MODEL=base.en       # faster-whisper model id: tiny.en, base.en, small.en, …

# --- broker ---
MOXIE_BROKER_HOST=192.168.1.9  # host/IP the ROBOT uses to reach the broker (endpoint QR)
