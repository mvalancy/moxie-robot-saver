# Copy to .env and edit. All local-first.
# Which brain drives Moxie: llm | echo | webhook
MOXIE_APP=llm

# Broker the ROBOT connects to (goes into the endpoint QR)
MOXIE_BROKER_HOST=192.168.1.9
MOXIE_BROKER_PORT=8883

# Supervisor -> broker (loopback)
MOXIE_MQTT_HOST=127.0.0.1
MOXIE_MQTT_PORT=1883

# LLM (any OpenAI-compatible endpoint — local-first, no vendor lock-in)
MOXIE_LLM_BASE_URL=http://127.0.0.1:4000/v1
MOXIE_LLM_API_KEY=sk-local
MOXIE_LLM_MODEL=qwen3.8-27b

# Webhook app (external avatar bridge) — only if MOXIE_APP=webhook
# MOXIE_WEBHOOK_ENDPOINT=http://127.0.0.1:9000/moxie
