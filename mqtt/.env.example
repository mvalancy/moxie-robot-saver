# Moxie backend LLM config. Copy to `mqtt/.env` and fill in.
# `.env` is gitignored — NEVER commit real endpoints or API keys.

MOXIE_APP=llm                 # llm | echo | webhook

# --- Option A: Ollama (recommended, fully offline) --------------------------
# ollama pull llama3.1  &&  ollama serve
# MOXIE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# MOXIE_LLM_API_KEY=ollama
# MOXIE_LLM_MODEL=llama3.1

# --- Option B: LiteLLM gateway (or any OpenAI-compatible endpoint) ----------
# MOXIE_LLM_BASE_URL=https://your-litellm-host/v1
# MOXIE_LLM_API_KEY=sk-...
# MOXIE_LLM_MODEL=your-model-name

# Who Moxie is talking to
MOXIE_CHILD_NICKNAME=friend
